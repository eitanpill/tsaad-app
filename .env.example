# Environment for צעד קטן ביום. Full list with owners and defaults: docs/LAUNCH_CHECKLIST.md.
# [required] = the server refuses to start in production without it (src/config/required.ts).
# [secret]   = set as a Sensitive variable on Vercel; never NEXT_PUBLIC, never in the repo.
# Never set on Vercel: TSAAD_E2E, TSAAD_TEST_NOW, TSAAD_TEST_CLOCK_KEY, TSAAD_WEBHOOK_CAPTURE_FILE (test only).
# [required][secret] Postgres connection string, pooled Neon URL for the app (server only)
DATABASE_URL=
# true enables the tracker sync job (לא פעיל כברירת מחדל)
TRACKER_SYNC_ENABLED=false
# true enables push/SMS reminders (לא פעיל כברירת מחדל)
REMINDERS_ENABLED=false
# GHL sending, all OFF by default (docs/GHL_SETUP.md). off = as before; dry = log what would be sent, no GHL call; live = call the GHL API.
# Reminder mode: at 07:30 sets the contact field GHL_FIELD_TODAY_URL and adds the tag GHL_TAG_REMINDER_PREFIX + day number.
GHL_REMINDER_MODE=off
# Link delivery mode: writes the one-time activation/reset link to GHL_FIELD_ACTIVATION_URL and adds GHL_TAG_ACCOUNT_READY / GHL_TAG_RESET_READY.
GHL_DELIVERY_MODE=off
# [secret] GHL Private Integration token (needed only for live; never in the repo). Never enabled in tests/e2e.
GHL_API_TOKEN=
# GHL sub-account (location) id (needed only for live)
GHL_LOCATION_ID=
# Names (keys) of the custom fields and tags you create in GHL. These are the defaults; empty = default.
GHL_FIELD_TODAY_URL=tsaad_today_url
GHL_FIELD_ACTIVATION_URL=tsaad_activation_url
# Recommended for live: the GHL ids of those two custom fields (Settings > Custom Fields, copy each field's id).
# Set = the app sends {id, fieldValue}; empty = {key, fieldValue} with the names above.
GHL_FIELD_TODAY_URL_ID=
GHL_FIELD_ACTIVATION_URL_ID=
GHL_TAG_REMINDER_PREFIX=tsaad_reminder_day
GHL_TAG_ACCOUNT_READY=tsaad_account_ready
GHL_TAG_RESET_READY=tsaad_reset_ready
# GoHighLevel inbound webhook URL (server only, never NEXT_PUBLIC)
GHL_WEBHOOK_URL=
# Bunny Stream library id for video hosting
BUNNY_LIBRARY_ID=
# [secret] Bunny Stream token authentication key (server only)
BUNNY_TOKEN_KEY=
# optional: the library CDN hostname (Bunny Stream, Library, CDN Hostname, a *.b-cdn.net name). With it, the Today video tile shows the video thumbnail as its poster.
BUNNY_CDN_HOST=
# Bunny video ids for days 1..14, comma-separated in order; empty slot = no video yet (not set until the videos exist)
BUNNY_VIDEO_IDS=
# VAPID public key for web push (safe to expose)
VAPID_PUBLIC_KEY=
# [secret] VAPID private key for web push (server only)
VAPID_PRIVATE_KEY=
# Challenge start date, YYYY-MM-DD
START_DATE=
# Daily unlock time, HH:MM in TZ_NAME
UNLOCK_HOUR=05:00
# Daily reminder time, HH:MM in TZ_NAME
REMINDER_TIME=07:30
# IANA timezone used for day boundaries
TZ_NAME=Asia/Jerusalem
# [required][secret] Secret for signing/hashing sessions, at least 32 random characters (server only)
SESSION_SECRET=
# [secret] Shared secret the GHL signup webhook must present, at least 32 characters (server only)
GHL_WEBHOOK_SECRET=
# [secret] Bearer secret for /api/cron/*, at least 16 characters (Vercel Cron sends it automatically)
CRON_SECRET=
# VAPID subject for web push: mailto:... or https://... (not set until agreed)
VAPID_SUBJECT=
# Live session links (day 7 / day 14), https URLs (not set until agreed)
LIVE_URL_DAY7=
LIVE_URL_DAY14=
# Live session start times, HH:MM in TZ_NAME (not set until agreed)
LIVE_TIME_DAY7=
LIVE_TIME_DAY14=
# Outside Vercel only: "true" if a proxy in front of the app overwrites x-real-ip /
# x-forwarded-for. Otherwise leave empty (per-IP limits are then off; per-username and per-account limits stay).
TRUST_PROXY_IP_HEADERS=
# [required] Public origin of the app, e.g. https://example.com (no trailing slash)
APP_ORIGIN=
# [required] One-time activation/reset link lifetime, whole minutes (not set until agreed)
ACTIVATION_LINK_TTL_MINUTES=
# Real number of open places for the day-14 personal Zoom session offer (/offer shows "N מקומות.").
# A fixed number: it does not count down as people book. Leave empty unless it is true right now.
SESSION_SPOTS=
# How long the day-14 offers stay open, whole hours (not set until agreed)
OFFER_WINDOW_HOURS=48
# Payment pages (Morning), https only. Empty = the button shows as disabled.
MORNING_URL_CHALLENGE_79=
MORNING_URL_SESSION_271=
MORNING_URL_BUNDLE_139=
MORNING_URL_YESODOT_1265=
# Optional https link "לעדכון על המחזור הבא", shown on the landing page only after registration closed (end of challenge day 2, Israel time). Empty = nothing is shown.
NEXT_COHORT_URL=
# utm_campaign per offer link: letters, digits, _ . - (empty = not added)
OFFER_UTM_SESSION=
OFFER_UTM_BUNDLE=
OFFER_UTM_YESODOT=
# Yesodot price valid until: YYYY-MM-DD (end of that day, Israel time) or ISO 8601 with offset
YESODOT_OFFER_EXPIRY=
# Usernames (comma-separated, no spaces needed, case-insensitive) allowed to open /admin/stats (aggregate numbers only).
# Empty = nobody. Everyone else, and anyone logged out, gets the normal 404.
ADMIN_USERNAMES=
# Contacts shown on the legal pages (email, phone or short text). Empty = neutral line.
# The accessibility contact (coordinator name + phone/email) is required by the accessibility regulations before launch.
ACCESSIBILITY_CONTACT=support@yogit-yoga.co.il
PRIVACY_CONTACT=
SUPPORT_CONTACT=support@yogit-yoga.co.il
