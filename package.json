{
  "name": "tsaad-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "scripts/test-db.sh run -- vitest run --no-file-parallelism",
    "test:e2e": "scripts/test-db.sh run -- playwright test",
    "dev:create-user": "NODE_ENV=development tsx scripts/create-dev-user.ts",
    "admin:create-user": "node --env-file=.env.local --conditions=react-server --import tsx scripts/admin-create-user.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
